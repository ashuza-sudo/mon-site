<svg width="300" height="400" viewBox="0 0 300 400" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="bookGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#667eea;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#764ba2;stop-opacity:1" />
    </linearGradient>
  </defs>

  <!-- Book cover -->
  <rect x="20" y="20" width="260" height="360" rx="10" ry="10" fill="url(#bookGradient)" stroke="#333" stroke-width="2"/>

  <!-- Book spine effect -->
  <rect x="15" y="25" width="270" height="350" rx="8" ry="8" fill="none" stroke="#fff" stroke-width="1" opacity="0.3"/>

  <!-- Book title area -->
  <rect x="40" y="60" width="220" height="40" rx="5" ry="5" fill="#fff" opacity="0.9"/>
  <text x="150" y="85" text-anchor="middle" font-family="Arial, sans-serif" font-size="16" font-weight="bold" fill="#333">Titre du Livre</text>

  <!-- Author area -->
  <rect x="40" y="120" width="180" height="25" rx="3" ry="3" fill="#fff" opacity="0.7"/>
  <text x="130" y="137" text-anchor="middle" font-family="Arial, sans-serif" font-size="12" fill="#666">Auteur</text>

  <!-- Content lines -->
  <line x1="40" y1="170" x2="260" y2="170" stroke="#fff" stroke-width="2" opacity="0.8"/>
  <line x1="40" y1="190" x2="240" y2="190" stroke="#fff" stroke-width="2" opacity="0.8"/>
  <line x1="40" y1="210" x2="250" y2="210" stroke="#fff" stroke-width="2" opacity="0.8"/>
  <line x1="40" y1="230" x2="220" y2="230" stroke="#fff" stroke-width="2" opacity="0.8"/>
  <line x1="40" y1="250" x2="245" y2="250" stroke="#fff" stroke-width="2" opacity="0.8"/>
  <line x1="40" y1="270" x2="235" y2="270" stroke="#fff" stroke-width="2" opacity="0.8"/>
  <line x1="40" y1="290" x2="255" y2="290" stroke="#fff" stroke-width="2" opacity="0.8"/>
  <line x1="40" y1="310" x2="225" y2="310" stroke="#fff" stroke-width="2" opacity="0.8"/>
  <line x1="40" y1="330" x2="240" y2="330" stroke="#fff" stroke-width="2" opacity="0.8"/>
</svg>